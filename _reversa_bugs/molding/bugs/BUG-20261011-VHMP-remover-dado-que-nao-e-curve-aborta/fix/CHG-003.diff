+def scene_molding(scene, molding_type=None):
+    """Package sweeps and their hidden profiles in the scene, optionally
+    scoped to one molding type. Unscoped, it also picks up profiles left
+    behind by a sweep the user deleted by hand."""
+    found = []
+    for obj in scene.objects:
+        if obj.get(MOLDING_TAG):
+            if molding_type and obj.get(MOLDING_TYPE) != molding_type:
+                continue
+            found.append(obj)
+            bevel = obj.data.bevel_object if obj.type == 'CURVE' else None
+            if bevel is not None and bevel.get('IS_HB_MOLDING_PROFILE'):
+                found.append(bevel)
+        elif (molding_type is None and obj.get('IS_HB_MOLDING_PROFILE')
+              and (obj.parent is None or not obj.parent.get(MOLDING_TAG))):
+            found.append(obj)
+    return list(dict.fromkeys(found))
+
+
+def _remove(objs):
+    for obj in objs:
+        try:
+            alive = obj.name in bpy.data.objects
+        except ReferenceError:
+            continue
+        if alive:
+            packages.free_object(obj)
+
